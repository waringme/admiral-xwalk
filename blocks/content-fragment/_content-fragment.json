          "options": [
            {
              "name": "Alternating (large illustrations)",
              "value": "alternating"
            },
            {
              "name": "Pods (blue)",
              "value": "pods"
            },
            {
              "name": "Pods (colours, with icons)",
              "value": "pods-colours"
            },
            {
              "name": "Hide heading",
              "value": "no-heading"
            }
          ]
        }
      ]
    }
